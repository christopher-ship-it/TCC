rules_version = '2';

// TCC's operational data (agents, customerOverlay, escalations,
// clearedEscalations). Requires request.auth != null — the app signs every
// browser in anonymously on load, so this blocks the open internet without
// needing real per-agent Firebase Auth accounts yet.
//
// To apply: Firebase Console -> Firestore Database -> Rules -> paste this -> Publish.
// Also needed once: Authentication -> Sign-in method -> enable "Anonymous".
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
