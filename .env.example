# Firebase project dedicated to TCC's own operational data (agents, calls,
# tickets, follow-ups, escalations). Copy this file to .env.local and fill
# in real values from Firebase Console -> Project Settings -> Your apps.
# .env.local is gitignored — never commit real keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# In-app calling (src/telephony). Leave VITE_TELEPHONY_PROVIDER unset to keep the plain tel: dial link.
#   telecmi -> real calls through TeleCMI's browser softphone (agents sign in with their own TeleCMI user)
#   mock    -> fake phone line for demos/dev; never dials anyone
VITE_TELEPHONY_PROVIDER=
# TeleCMI signalling host: sbcind.telecmi.com (India, default), sbcsg / sbcuk / sbcus .telecmi.com
VITE_TELECMI_REGION=
# Country code added to 10-digit numbers (default 91)
VITE_TELEPHONY_COUNTRY_CODE=
# Customer numbers are sample data for now. With telecmi, live dialling stays blocked until you choose:
#   a number here -> EVERY call is redirected to it (safe end-to-end testing with your own phone), or
VITE_TELEPHONY_TEST_NUMBER=
#   true          -> dial each customer's own number (only once real customer data is connected)
VITE_TELEPHONY_LIVE=
# true -> log raw softphone SDK events to the browser console
VITE_TELECMI_DEBUG=

# TeleCMI App ID (Dashboard > Settings > Developer). Public — it identifies the account in recording URLs.
VITE_TELECMI_APP_ID=
# Dashboard host for this account; recordings play from https://<host>/connly_voice/download_music/<file>
VITE_TELECMI_DASHBOARD_HOST=connle.telecmi.com
# NEVER put the TeleCMI App Secret in a VITE_ variable: anything prefixed VITE_ is compiled into the browser
# bundle and readable by every visitor. It belongs on a server (Cloud Functions / backend) only.

# Local transcription service (npm run transcribe) — Whisper on this machine, no API key. Default shown.
VITE_TRANSCRIBE_URL=http://127.0.0.1:8787
